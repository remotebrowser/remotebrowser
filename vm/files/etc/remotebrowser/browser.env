# Command-line flags for Chromium, read by chromium.service.
#
# Headful on Xvnc, maximized by openbox. All traffic goes through tinyproxy.
# The VM has no GPU. Without the SwiftShader flags, the browser has no
# software fallback, so WebGL and WebGPU are not available.
BROWSER_FLAGS="--remote-debugging-port=9221 \
  --proxy-server=http://127.0.0.1:8119 \
  --user-data-dir=/home/browser/profile \
  --start-maximized \
  --no-first-run --no-default-browser-check --disable-default-apps \
  --disable-background-networking --disable-component-update \
  --disable-domain-reliability --disable-sync --no-pings \
  --disable-features=OptimizationGuideModelDownloading,OptimizationHints,OptimizationTargetPrediction"
