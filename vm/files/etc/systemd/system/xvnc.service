[Unit]
Description=Virtual display for the browser, viewable over VNC

[Service]
User=browser
# Port 5900 serves the display over RFB to any VNC viewer. It needs no
# password: QEMU forwards it only to the host's loopback, like CDP.
# -alwaysshared lets several viewers watch at once.
ExecStart=/usr/bin/Xvnc :99 -alwaysshared -AcceptSetDesktopSize=0 \
  -geometry 1920x1080 -depth 24 -rfbport 5900 -SecurityTypes None -nolisten tcp
# The screen size that the host may set (see screen-resolution). Xvnc starts at
# 1920x1080, e.g. after a crash, so it is set again here. A failure leaves
# that size, and keeps the display up.
ExecStartPost=-/usr/local/sbin/screen-resolution
Restart=always

[Install]
WantedBy=multi-user.target
