[Unit]
Description=X settings for the browser, such as the screen scale
# Chromium reads its scale from the X DPI here, and follows a change at once
# (see screen-scale).
Requires=display.service
After=display.service

[Service]
User=browser
Environment=DISPLAY=:99
ExecStartPre=/bin/sh -c 'until [ -S /tmp/.X11-unix/X99 ]; do sleep 0.1; done'
ExecStart=/usr/bin/xsettingsd -c /etc/remotebrowser/xsettingsd.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
