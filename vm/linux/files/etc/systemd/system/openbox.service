[Unit]
Description=Window manager for the browser
# Keeps the browser maximized, also when the host changes the screen size.
# Without it, --start-maximized does nothing.
Requires=display.service
After=display.service

[Service]
User=browser
Environment=DISPLAY=:99 HOME=/home/browser
ExecStartPre=/bin/sh -c 'until [ -S /tmp/.X11-unix/X99 ]; do sleep 0.1; done'
ExecStart=/usr/bin/openbox
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
