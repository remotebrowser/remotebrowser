[Unit]
Description=Tell the host that the guest is ready for a snapshot
# The host saves the snapshot when it sees this line on the serial console:
# everything the browser needs is up, and the browser itself is not.
Requires=display.service nftables.service tinyproxy.service
After=display.service nftables.service tinyproxy.service cdp-proxy.service network.target

[Service]
Type=oneshot
ExecStartPre=/usr/local/bin/wait-for-display
ExecStartPre=-/usr/local/bin/clear-memory
ExecStart=/bin/echo remotebrowser: guest ready
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
