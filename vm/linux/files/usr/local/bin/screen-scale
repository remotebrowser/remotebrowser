#!/bin/sh
# Sets the labwc output scale to the screen scale that the host sets in
# /etc/remotebrowser/screen-scale (see src/vm/screen-scale.js). Chromium
# follows a change at once, through the fractional scale protocol.
#
# The file holds one line: the scale in percent, e.g. 150, or "default".
# Anything else, e.g. a write that the host did not finish, is an error, and
# the scale stays as it is.
set -eu
file=/etc/remotebrowser/screen-scale

# No file is the image as it was built: 150%, as in src/vm/screen-scale.js.
scale=150
if [ -f "$file" ]; then
  if [ "$(wc -l <"$file")" -ne 1 ] || [ -n "$(tail -c 1 "$file")" ]; then
    echo "$file must hold exactly one line" >&2
    exit 1
  fi
  line=$(cat "$file")
  if [ "$line" != default ]; then
    scale=$line
  fi
fi
if ! printf '%s\n' "$scale" | grep -Eqx '[1-9][0-9]{2}' || [ "$scale" -gt 300 ] || [ $((scale % 25)) -ne 0 ]; then
  echo "$file does not hold a valid scale" >&2
  exit 1
fi

# labwc forgets it when it restarts, so display.service sets it again.
/usr/local/bin/wait-for-display
export XDG_RUNTIME_DIR=/run/display WAYLAND_DISPLAY=wayland-0
# The VM has one output: the first word that wlr-randr prints.
output=$(wlr-randr | awk 'NR == 1 { print $1 }')
wlr-randr --output "$output" --scale "$((scale / 100)).$((scale % 100))"
